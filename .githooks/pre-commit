#!/bin/sh
# SokraKI: verhindert, dass Zugangsdaten ins Repository gelangen.
# Einmalig je Klon aktivieren: npm run schutz-aktivieren

env_dateien=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env' | grep -vE '(^|/)\.env\.example$')
if [ -n "$env_dateien" ]; then
  echo "Commit abgebrochen: Diese Dateien enthalten Zugangsdaten und gehören nicht ins Repository:"
  echo "$env_dateien"
  exit 1
fi

if git diff --cached -U0 --diff-filter=ACMR | grep -qE '^\+.*(sk-or-v1-[A-Za-z0-9]{16,}|sk-ant-[A-Za-z0-9_-]{16,})'; then
  echo "Commit abgebrochen: Im Commit steckt etwas, das wie ein API-Schlüssel aussieht."
  echo "Entferne ihn und trage Schlüssel nur in .env.local ein."
  exit 1
fi

exit 0
