# Kopiere diese Datei nach .env.local und trage die Werte ein.
# Achtung Windows-Editor: Die Datei muss genau ".env.local" heißen, nicht ".env.local.txt".
# .env.local wird von Git ignoriert und nur auf dem Server gelesen – der Schlüssel erreicht nie den Browser.

# "skript"     = Lernbegleiter nach Gesprächsleitfaden und vorbereitete Arbeitsblatt-Entwürfe (ohne KI, ohne Kosten)
# "openrouter" = Lernbegleiter und Arbeitsblatt über OpenRouter (benötigt OPENROUTER_API_KEY)
# "claude"     = Lernbegleiter und Arbeitsblatt direkt über die Claude API (benötigt Zugangsdaten)
KI_MODUS=skript

# OpenRouter (KI_MODUS=openrouter): Schlüssel auf openrouter.ai unter „Keys“ anlegen und Guthaben aufladen.
# Tipp: Beim Schlüssel ein Ausgabenlimit (Credit limit) setzen.
OPENROUTER_API_KEY=
OPENROUTER_MODELL=anthropic/claude-haiku-5.5
# Optional: Verarbeitung nur in der EU (erfordert einen Business- oder Enterprise-Tarif bei OpenRouter)
# OPENROUTER_BASE_URL=https://eu.openrouter.ai/api/v1

# Claude API direkt (KI_MODUS=claude). Alternativ reicht ein mit `ant auth login` angelegtes Profil.
ANTHROPIC_API_KEY=
KI_MODELL=claude-opus-5-5

# Denktiefe für beide KI-Modi
KI_EFFORT=low

# Kostenbremse: höchstens so viele KI-Aufrufe pro Minute und pro 24 Stunden (ein Kursdurchlauf ≈ 11 Aufrufe)
# KI_LIMIT_PRO_MINUTE=20
# KI_LIMIT_PRO_TAG=300
