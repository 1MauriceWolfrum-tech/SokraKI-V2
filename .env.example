# Kopiere diese Datei nach .env.local und trage die Werte ein.

# "skript" = Lernbegleiter nach Gesprächsleitfaden und vorbereitete Arbeitsblatt-Entwürfe (ohne KI, ohne Kosten)
# "claude" = Lernbegleiter und Arbeitsblatt über die Claude API (benötigt Zugangsdaten)
KI_MODUS=skript

# Zugang zur Claude API. Alternativ reicht ein mit `ant auth login` angelegtes Profil.
ANTHROPIC_API_KEY=

# Optional: Modell und Denktiefe
KI_MODELL=claude-opus-5-5
KI_EFFORT=low
